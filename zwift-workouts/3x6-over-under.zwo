<workout_file>
    <author>R.Walker / Coach Claude</author>
    <name>3x6 Over-Under (Diagnostic)</name>
    <description>3 x 6 min over-under. Each 6-min block alternates 1 min @ 105% FTP (over) / 1 min @ 95% FTP (under), repeated 3 times. 5 min easy spin between blocks. First over-under session post-Red Eagle — purpose is diagnostic: where does the supra-threshold reaction break down? Rep 1 should feel hard but doable. Rep 2 is the truth. Rep 3 is whether you can come back. If you complete all three cleanly, peak-week version goes to 4x6 or pushes overs to 110%. Cadence 88-95 on overs, 85-90 on unders. FTP 230W → over = 241W, under = 218W.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="INTERVALS"/>
        <tag name="THRESHOLD"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.50" PowerHigh="0.75" pace="0"/>
        <SteadyState Duration="60" Power="0.90" pace="0">
            <textevent timeoffset="0" message="60s priming effort at 90% — wake the legs"/>
        </SteadyState>
        <SteadyState Duration="120" Power="0.55" pace="0">
            <textevent timeoffset="0" message="Easy spin. Block 1 coming up."/>
            <textevent timeoffset="60" message="60 seconds to over-under block 1"/>
        </SteadyState>

        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.95" pace="0" Cadence="90" CadenceResting="88">
            <textevent timeoffset="0" message="BLOCK 1 — OVER. 1 min at 105%. Smooth, not pushing."/>
            <textevent timeoffset="60" message="UNDER. 1 min at 95%. This IS the recovery — stay strong."/>
        </IntervalsT>

        <SteadyState Duration="300" Power="0.55" pace="0">
            <textevent timeoffset="0" message="5 min easy spin. Block 1 done — how were the unders? Real recovery or drowning?"/>
            <textevent timeoffset="240" message="60 seconds to block 2 — this is the truth-teller rep"/>
        </SteadyState>

        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.95" pace="0" Cadence="90" CadenceResting="88">
            <textevent timeoffset="0" message="BLOCK 2 — OVER. Hold form. Notice how the under feels different now."/>
            <textevent timeoffset="60" message="UNDER. Breathe. Recover here or you don't finish block 3."/>
        </IntervalsT>

        <SteadyState Duration="300" Power="0.55" pace="0">
            <textevent timeoffset="0" message="5 min easy. One block left. Honest check: can you do it cleanly?"/>
            <textevent timeoffset="240" message="Last one. 60 seconds. Show me you can come back from the damage."/>
        </SteadyState>

        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.95" pace="0" Cadence="90" CadenceResting="88">
            <textevent timeoffset="0" message="BLOCK 3 — OVER. This is the rep that matters."/>
            <textevent timeoffset="60" message="UNDER. Last under of the day. Hold it together."/>
        </IntervalsT>

        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45" pace="0">
            <textevent timeoffset="0" message="Done. Spin easy. We'll debrief on RPE per block."/>
        </Cooldown>
    </workout>
</workout_file>
